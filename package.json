{
  "name": "lapasar-corp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run apps/api/src/main.ts",
    "dev:watch": "bun --watch run apps/api/src/main.ts",
    "build": "bunx tsc -b",
    "lint": "bunx prettier --check .",
    "format": "bunx prettier --write .",
    "test": "bun test",
    "openapi": "bun run packages/tooling/openapi-gen.ts"
  },
  "prettier": "./packages/tooling/prettier.config.cjs",
  "dependencies": {
    "hono": "^4.9.9",
    "mongodb": "6.20",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.7.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
