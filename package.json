{
  "name": "lapasar-corp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/monolith && bun run --watch src/main.ts",
    "build": "bun build apps/monolith/src/main.ts --outdir dist --target bun",
    "start": "NODE_ENV=production bun run dist/main.js",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "bun run scripts/seed.ts",
    "generate:openapi": "bun run scripts/generate-openapi.ts",
    "check:env": "bun run scripts/check-env.ts",
    "migrate": "bun run scripts/migrate.ts",
    "migrate:up": "bun run scripts/migrate.ts up",
    "migrate:down": "bun run scripts/migrate.ts down",
    "migrate:status": "bun run scripts/migrate.ts status",
    "migrate:create": "bun run scripts/create-migration.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "ulid": "^3.0.1",
    "undici": "^7.16.0"
  }
}