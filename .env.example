# * Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# * Database
MONGODB_URI=mongodb://localhost:27017/lapasar-corp
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# * Redis Cache (optional - uses InMemoryCache if not provided)
REDIS_URL=redis://localhost:6379

# * JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-token-change-this
JWT_REFRESH_EXPIRES_IN=30d

# * Security
ARGON2_MEMORY_SIZE=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# * Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# * Logging
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_TO_DB=false
LOG_FILE_PATH=/var/log/lapasar/app.log
LOG_FILE_MAX_SIZE=100MB
LOG_FILE_MAX_FILES=30

# * Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# * Event Bus (for future microservices)
RABBITMQ_URL=amqp://localhost:5672
EVENT_BUS_TYPE=in-memory

# * Localization
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ms

# * Email (future)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# * SMS (future)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
